# Ports (change if you get "port already allocated")
NGINX_HTTPS_PORT=20300
MARIADB_PORT=20301
PHPMYADMIN_PORT=20302

# App
WP_URL=https://localhost:20300
WP_TITLE=Framework MCP Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=demo
WP_ADMIN_EMAIL=admin@example.com
MCP_ADAPTER_VERSION=v0.7.1

# Database
DB_NAME=framework_mcp_dev
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Xdebug (trigger mode: debugging starts only with XDEBUG_TRIGGER or a browser extension)
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=PHPSTORM
