{
	"name": "ahamed/framework-mcp",
	"type": "library",
	"description": "MCP server support for themeum/framework WordPress plugins, built on the WordPress MCP Adapter.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"mcp",
		"model-context-protocol",
		"themeum",
		"framework"
	],
	"authors": [
		{
			"name": "Sajeeb Ahamed",
			"email": "sajeeb07ahamed@gmail.com"
		}
	],
	"homepage": "https://github.com/ahamed/framework-mcp",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/themeum/framework.git"
		}
	],
	"require": {
		"php": ">=7.4",
		"themeum/framework": "^3.2.7"
	},
	"suggest": {
		"wordpress/mcp-adapter": "Required at runtime to expose MCP servers. Install the MCP Adapter plugin on the site rather than bundling it."
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"squizlabs/php_codesniffer": "^3.7",
		"symfony/finder": "^5.4",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Ahamed\\FrameworkMcp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Ahamed\\FrameworkMcp\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"scripts": {
		"test": "vendor/bin/phpunit --prepend tests/prepend.php --testdox",
		"test:unit": "vendor/bin/phpunit --prepend tests/prepend.php --testsuite Unit --testdox",
		"phpcs": "@php -d auto_prepend_file= scripts/run-phpcs.php",
		"phpcbf": "@php -d auto_prepend_file= scripts/run-phpcs.php phpcbf"
	},
	"bin": [
		"bin/framework-mcp-prefix-stubs"
	]
}
